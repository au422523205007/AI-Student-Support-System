@tool
def search_college_handbook(query: str) -> str:
    """Retrieves official guidelines, dress code, leave, hostel, exams, and discipline."""
    normalized_query = resolve_aliases(query)
    q_tokens = tokenize(normalized_query)
    
    # 1. Broad Policy Overview: Return primary regulations
    if normalized_query.strip() in ["policy", "policies", "rules", "rule", "code of conduct"]:
        sections = []
        for key in ["academic_attendance", "dress_and_grooming", "hostel_and_mess", "leave_and_od"]:
            sec = COLLEGE_POLICIES[key]
            rules_str = "\n  * ".join(sec["rules"])
            sections.append(f"[{sec['title']}]\n  * {rules_str}")
        return "\n\n".join(sections)

    # 2. Targeted Semantic Search using Cosine Similarity
    q_vec = Counter(q_tokens)
    scored_rules = []

    for section in COLLEGE_POLICIES.values():
        for rule in section["rules"]:
            rule_vec = Counter(tokenize(rule))
            score = cosine_similarity(q_vec, rule_vec)
            
            # Boost for category matches
            if section["category"] in normalized_query:
                score += 0.25
                
            if score > 0.08:
                scored_rules.append((score, rule, section["title"]))

    scored_rules.sort(key=lambda x: x[0], reverse=True)

    if scored_rules:
        # Return the top matches
        top_matches = [f"[{item[2]}] {item[1]}" for item in scored_rules[:3]]
        return "\n\n".join(top_matches)

    return "No official records found matching your inquiry. Please consult the admin desk."

@tool
def check_attendance_status(attended: int, total: int) -> str:
    """Calculates attendance percentage and verifies examination eligibility."""
    if total <= 0:
        return "Total scheduled classes must be greater than zero."
    
    pct = round((attended / total) * 100, 2)
    if pct >= 75.0:
        status = "ELIGIBLE (Clear to sit for exams)"
    elif pct >= 65.0:
        status = "CONDONATION REQUIRED (Requires Principal Medical Approval)"
    else:
        status = "DETAINED (Below 65% - Mandatory Re-enrollment)"
        
    return f"Calculated Attendance: {pct}%. Status: {status}."

class StudentSupportAgent:
    def route_and_execute(self, user_query: str) -> str:
        lower_q = user_query.lower()
        normalized_q = resolve_aliases(lower_q)
        
        # Tool Route 1: Numerical Attendance Evaluation
        if any(char.isdigit() for char in lower_q) and any(w in normalized_q for w in ["attendance", "class", "present"]):
            numbers = [int(s) for s in lower_q.replace("/", " ").replace("out of", " ").split() if s.isdigit()]
            if len(numbers) >= 2:
                attended, total = numbers[0], numbers[1]
                calc_result = check_attendance_status.invoke({"attended": attended, "total": total})
                policy_context = search_college_handbook.invoke("attendance rules")
                return f"{calc_result}\n\n[Reference Policy]:\n{policy_context}"

        # Conversational greetings
        if lower_q in ["hi", "hello", "hey", "help"]:
            return (
                "Hello! I am your AI Student Support Assistant.\n"
                "You can ask about: Dress code, Beard/Haircut rules, Hostel curfew, "
                "Mess timings, OD/Medical Leave, Exams, Anti-Ragging, or calculate attendance."
            )

        # Tool Route 2: Knowledge Retrieval via Normalized Alias Mapping
        return search_college_handbook.invoke(user_query)

