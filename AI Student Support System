def resolve_aliases(text: str) -> str:
    """Normalizes input terms, abbreviations, and slang into system-standard keywords."""
    clean_text = re.sub(r'[^\w\s-]', '', text.lower())
    tokens = clean_text.split()
    mapped_tokens = [ALIAS_MAP.get(token, token) for token in tokens]
    return " ".join(mapped_tokens)

